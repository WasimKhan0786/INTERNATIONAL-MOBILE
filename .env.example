# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/techzone?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production

# Cloudinary Image Storage Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Initial Administrator Details
ADMIN_EMAIL=admin@techzone.com
ADMIN_PASSWORD=admin123

# Rate Limiting Configuration Thresholds (Configurable)
# Auth endpoints (Stricter + Per-IP & Per-Account Exponential Backoff)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_BASE_BACKOFF_MS=5000
RATE_LIMIT_AUTH_MAX_BACKOFF_MS=3600000

# Public endpoints (Moderate limits)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=100

# Authenticated user actions (Looser limits)
RATE_LIMIT_AUTHED_WINDOW_MS=900000
RATE_LIMIT_AUTHED_MAX_REQUESTS=300

# Server Port
PORT=5000

